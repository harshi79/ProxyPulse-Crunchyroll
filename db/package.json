{
  "name": "@proxypulse/db",
  "version": "0.1.0",
  "private": true,
  "description": "Turso/libSQL schema, migrations and repositories",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node dist/cli.js",
    "status": "node dist/cli.js status",
    "prune": "node dist/cli.js prune"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@proxypulse/shared": "0.1.0"
  }
}
