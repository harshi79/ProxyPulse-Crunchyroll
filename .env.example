# ProxyPulse configuration — copy to `.env` and fill in.
#   cp .env.example .env
# Nothing here is a secret; the `.env` file itself is git-ignored. Never commit real tokens.

# ── Runtime ────────────────────────────────────────────────────────────────
# development | test | production (production enables the strict startup checks)
ENVIRONMENT=development
LOG_LEVEL=info
# The worker serves the internal API (and health checks) on this socket. Render injects PORT.
HOST=0.0.0.0
PORT=8080
# Name reported by every response. Only `crunchyroll` has an adapter today.
SERVICE_NAME=crunchyroll

# ── Database (Turso / libSQL) ──────────────────────────────────────────────
# Local file:    file:./data/proxypulse.db     (directory is created for you)
# In memory:     :memory:
# Turso:         libsql://<db>.turso.io
DATABASE_URL=file:./data/proxypulse.db
# Turso auth token. Prefer the real env var over a URL query string; it is never logged.
DATABASE_AUTH_TOKEN=
# Optional override for the SQL migration folder (defaults to db/migrations).
# DATABASE_MIGRATIONS_DIR=

# ── Internal API auth (worker <-> gateway only) ────────────────────────────
# Generate one with: npm run token --workspace @proxypulse/worker
# Must be at least 16 characters, and is required in production.
INTERNAL_API_TOKEN=

# ── Refresh cycle ──────────────────────────────────────────────────────────
# The pool is refreshed on this cadence (spec: 15 minutes). It is a rolling
# update, never a rebuild.
REFRESH_INTERVAL_MINUTES=15
REFRESH_JITTER_SECONDS=20
RUN_CYCLE_ON_STARTUP=1

# ── Discovery (publicly available lists, automated collection permitted) ────
# Sources live in config/sources.json by default; inline JSON is also accepted.
PROXY_SOURCES_FILE=config/sources.json
# PROXY_SOURCES_JSON=[{"id":"seed","kind":"local-file","path":"tests/fixtures/proxies.sample.txt"}]
DISCOVERY_CONCURRENCY=4
DISCOVERY_RETRIES=2
DISCOVERY_TIMEOUT_MS=15000
DISCOVERY_MAX_BYTES=8388608
DISCOVERY_CANDIDATE_CAP=20000
DISCOVERY_USER_AGENT=ProxyPulseBot/1.0 (+https://github.com/harshi79/ProxyPulse-Crunchyroll)

# ── Connectivity validation ────────────────────────────────────────────────
VALIDATION_CONCURRENCY=24
VALIDATION_CONNECT_TIMEOUT_MS=5000
VALIDATION_TIMEOUT_MS=8000
# Total attempts per proxy (1 = no retry). Only transient failures are retried.
VALIDATION_RETRIES=2
VALIDATION_BACKOFF_MS=400
VALIDATION_MAX_BYTES=65536
VALIDATION_MAX_PER_CYCLE=2000
# Fetched *through* each proxy to prove it forwards traffic.
VALIDATION_CHECK_URL=https://www.gstatic.com/generate_204
VALIDATION_SUCCESS_STATUSES=204,200,301,302
# Require the check endpoint to echo the proxy's egress address (needs an echo-capable URL).
VALIDATION_REQUIRE_EGRESS_ECHO=0

# ── Pool policy ────────────────────────────────────────────────────────────
POOL_MIN_SCORE=25
POOL_TTL_MINUTES=90
POOL_MAX_ACTIVE=5000
POOL_MAX_CONSECUTIVE_FAILURES=3
POOL_RECHECK_AFTER_MINUTES=15
POOL_MAX_NEW_PER_CYCLE=1500
POOL_MAX_RECHECK_PER_CYCLE=800
POOL_MAX_QUARANTINE_RECHECK_PER_CYCLE=400
# When 1, only proxies that passed the service check may be served by /pool?service=required.
POOL_REQUIRE_SERVICE_PASS=0

# ── Scoring knobs (0-100 output, weights sum to 1 internally) ──────────────
SCORE_IDEAL_LATENCY_MS=200
SCORE_MAX_LATENCY_MS=3000

# ── Authorized service compatibility check (see docs/ARCHITECTURE.md) ──────
# Probes ONE public, unauthenticated endpoint per proxy to see whether normal HTTPS traffic works.
# It never attempts to bypass geo-blocking, bot protection, CAPTCHAs, rate limits or auth.
CR_CHECK_ENABLED=1
CR_CHECK_SCHEME=https
CR_CHECK_PATH=/robots.txt
# Full URL override (dev/test only; must stay inside CR_ALLOWED_HOSTS).
# CR_CHECK_URL=
CR_ALLOWED_HOSTS=www.crunchyroll.com,static.crunchyroll.com,crunchyroll.com
CR_USER_AGENT=ProxyPulseBot/1.0 (+https://github.com/harshi79/ProxyPulse-Crunchyroll)
CR_TIMEOUT_MS=8000
CR_RATE_LIMIT_PER_MINUTE=30
CR_MAX_CHECKS_PER_CYCLE=250
CR_MIN_REQUEST_SPACING_MS=250
CR_RESPECT_ROBOTS=1
CR_RECHECK_AFTER_MINUTES=360
CR_MIN_SCORE=10
CR_ALLOW_RETEST_BLOCKED=1

# ── Queue (optional; the pipeline works without it) ─────────────────────────
# memory (default) | cloudflare (HTTP pull consumer, useful for multi-replica fan-out)
QUEUE_DRIVER=memory
QUEUE_CONCURRENCY=24
QUEUE_MEMORY_CAPACITY=20000
# Required only for QUEUE_DRIVER=cloudflare (token needs queues_read AND queues_write).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_QUEUE_ID=
CLOUDFLARE_QUEUES_TOKEN=
QUEUE_BATCH_SIZE=50
QUEUE_POLL_SECONDS=20
QUEUE_VISIBILITY_TIMEOUT_MS=60000
QUEUE_MAX_RETRIES=2

# ── Hard limits and retention ──────────────────────────────────────────────
MAX_REQUEST_BYTES=65536
DNS_CACHE_TTL_MS=60000
# Dev/test escape hatch: allow proxy endpoints on private/loopback addresses (mocks, demos).
# Cloud metadata addresses stay blocked either way. Never enable this in production.
ALLOW_PRIVATE_ENDPOINTS=0
RETENTION_RESULT_DAYS=14
RETENTION_DEAD_PROXY_DAYS=30
RETENTION_CYCLE_DAYS=30

# ── Cloudflare API gateway (api/ worker) — set these in the Worker, not here ─
# RENDER_ORIGIN=https://proxypulse-worker.onrender.com
# INTERNAL_API_TOKEN=<same value as above>
# API_PUBLIC_KEYS=<comma separated reader keys, e.g. pp_live_xxx,pp_live_yyy>
# RATE_LIMIT_MAX=120
# RATE_LIMIT_WINDOW_SECONDS=60
# CACHE_ENABLED=1
# UPSTREAM_TIMEOUT_MS=10000
